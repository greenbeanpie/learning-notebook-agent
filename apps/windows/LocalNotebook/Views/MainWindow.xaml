<Window
    x:Class="LocalNotebook.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Local Notebook Agent">
    <Grid Background="{StaticResource CanvasBgBrush}" Padding="12" ColumnSpacing="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Padding="8,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="NotebookTitleText" Text="Local Notebook Agent" FontSize="18" FontWeight="SemiBold" Foreground="#E3E3E3" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="NewNotebookBtn" Content="新建笔记本" Click="OnNewNotebookClick" />
                <Button x:Name="ModelSettingsBtn" Content="模型协议配置" Click="OnOpenSettingsClick" />
            </StackPanel>
        </Grid>

        <!-- Left Pane: Sources (Search deferred/omitted) -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBgBrush}" CornerRadius="16" Padding="14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="来源" FontSize="15" FontWeight="SemiBold" Foreground="#E3E3E3" />
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" HorizontalAlignment="Stretch" Content="+ 添加来源" Click="OnAddSourceClick" />
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Content="+ 创建笔记" Click="OnCreateNoteClick" />
                </Grid>
                <ListView x:Name="SourcesList" Grid.Row="2" SelectionMode="None" />
            </Grid>
        </Border>

        <!-- Center Pane: Chat -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBgBrush}" CornerRadius="16" Padding="18">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SummaryText" Grid.Row="0" Text="请添加来源或直接提问。" TextWrapping="Wrap" Foreground="#C4C7C5" />
                <ListView x:Name="ChatList" Grid.Row="1" SelectionMode="None" />
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInputBox" Grid.Column="0" PlaceholderText="提问或创作内容..." />
                    <Button x:Name="SendBtn" Grid.Column="1" Content="发送" Click="OnSendChatClick" />
                </Grid>
            </Grid>
        </Border>

        <!-- Right Pane: Studio (7 modalities, Video removed) -->
        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBgBrush}" CornerRadius="16" Padding="14">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Studio" FontSize="15" FontWeight="SemiBold" Foreground="#E3E3E3" />
                <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Content="音频概览" Tag="audio" Click="OnStudioTileClick" />
                    <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Content="演示文稿" Tag="slides" Click="OnStudioTileClick" />
                    <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Content="思维导图" Tag="mindmap" Click="OnStudioTileClick" />
                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Content="报告" Tag="report" Click="OnStudioTileClick" />
                    <Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" Content="闪卡" Tag="flashcards" Click="OnStudioTileClick" />
                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Content="测验" Tag="quiz" Click="OnStudioTileClick" />
                    <Button Grid.Row="3" Grid.Column="0" HorizontalAlignment="Stretch" Content="信息图" Tag="infographic" Click="OnStudioTileClick" />
                </Grid>
                <ListView x:Name="ArtifactsList" Grid.Row="2" SelectionMode="None" />
            </Grid>
        </Border>
    </Grid>
</Window>
