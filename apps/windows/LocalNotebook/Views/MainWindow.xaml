<Window
    x:Class="LocalNotebook.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Local Notebook Agent">
    <Grid x:Name="RootGrid" Background="{StaticResource CanvasBgBrush}" Padding="14" ColumnSpacing="14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SourcesCol" Width="320" />
            <ColumnDefinition x:Name="ChatCol" Width="*" />
            <ColumnDefinition x:Name="StudioCol" Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Shared offscreen host for KaTeX WebView2 formula rendering -->
        <Canvas x:Name="MathRenderHost" Grid.Row="1" Grid.Column="1" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Top header -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Padding="6,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Width="30" Height="30" VerticalAlignment="Center">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/logo.svg" />
                    </Image.Source>
                </Image>
                <TextBox x:Name="NotebookTitleText" FontSize="18" FontWeight="SemiBold" MinWidth="120" MaxWidth="360" MaxLength="120"
                         Foreground="{StaticResource TextPrimaryBrush}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,4"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" AcceptsReturn="False"
                         GotFocus="OnTitleBoxGotFocus" LostFocus="OnTitleBoxLostFocus" KeyDown="OnTitleBoxKeyDown" PointerEntered="OnTitleBoxPointerEntered" PointerExited="OnTitleBoxPointerExited" />
                <ComboBox x:Name="NotebookPicker" MinWidth="190" MinHeight="38" Padding="12,8" VerticalAlignment="Center"
                          SelectionChanged="OnNotebookPicked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="NewNotebookBtn" Style="{StaticResource PillButtonStyle}" Click="OnNewNotebookClick" />
                <Button x:Name="SettingsBtn" Style="{StaticResource PillButtonStyle}" Click="OnOpenSettingsClick">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                            <PathIcon Width="24" Height="24" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                        </Viewbox>
                        <TextBlock x:Name="SettingsBtnText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NotebookMenuBtn" Style="{StaticResource PillButtonStyle}" MinWidth="38" Width="38" MinHeight="38" Height="38" CornerRadius="19" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <PathIcon Width="24" Height="24" Data="M6,10A2,2 0 0,0 4,12A2,2 0 0,0 6,14A2,2 0 0,0 8,12A2,2 0 0,0 6,10M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M18,10A2,2 0 0,0 16,12A2,2 0 0,0 18,14A2,2 0 0,0 20,12A2,2 0 0,0 18,10Z" />
                    </Viewbox>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="RenameNotebookItem" Click="OnRenameNotebookClick" />
                            <MenuFlyoutItem x:Name="ExportLnaItem" Click="OnExportLnaClick" />
                            <MenuFlyoutItem x:Name="ExportMdItem" Click="OnExportMarkdownClick" />
                            <MenuFlyoutItem x:Name="ImportLnaItem" Click="OnImportLnaClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ClearChatItem" Click="OnClearChatClick" />
                            <MenuFlyoutItem x:Name="DeleteNotebookItem" Click="OnDeleteNotebookClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="ExportDiagItem" Click="OnExportDiagnosticsClick" />
                            <MenuFlyoutItem x:Name="PrivacyItem" Click="OnShowPrivacyClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Left: sources and notes (Home list OR inline Source preview) -->
        <Border x:Name="SourcesPaneBorder" Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
            <Grid>
                <Grid x:Name="SourcesHomeView" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SourcesHeaderText" Grid.Row="0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,0" />
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DropDownButton x:Name="AddSourceBtn" Grid.Column="0" HorizontalAlignment="Stretch" Style="{StaticResource PillDropDownButtonStyle}">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem x:Name="AddFileMenuItem" Click="OnAddSourceClick" />
                                    <MenuFlyoutItem x:Name="AddUrlMenuItem" Click="OnAddUrlClick" />
                                    <MenuFlyoutItem x:Name="AddPasteMenuItem" Click="OnAddPasteClick" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button x:Name="CreateNoteBtn" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource PillButtonStyle}" Click="OnCreateNoteClick" />
                    </Grid>
                    <ListView x:Name="SourcesList" Grid.Row="2" SelectionMode="None" ItemContainerStyle="{StaticResource StretchListViewItemStyle}" />
                </Grid>

                <ContentControl x:Name="SourceDetailHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </Border>

        <!-- Center: chat -->
        <Border x:Name="ChatPaneBorder" Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource ElevatedBgBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="10" x:Name="SummaryCard">
                        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" MaxLines="6" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <Grid x:Name="SuggestedPanel" ColumnSpacing="10" />
                    </StackPanel>
                </Border>
                <ListView x:Name="ChatList" Grid.Row="1" SelectionMode="None" ItemContainerStyle="{StaticResource StretchListViewItemStyle}" />
                <Border Grid.Row="2" Background="{StaticResource ElevatedBgBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="26" MinHeight="52" Padding="8,6,8,6">
                    <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl x:Name="ChatAttachStripHost" Grid.Row="0" HorizontalContentAlignment="Stretch" Margin="8,2,0,0" />
                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="ChatAttachBtnHost" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBox x:Name="ChatInputBox" Grid.Column="1" MinHeight="38" FontSize="14" AcceptsReturn="False" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" KeyDown="OnChatKeyDown" />
                        <Button x:Name="SendBtn" Grid.Column="2" MinWidth="40" Width="40" MinHeight="40" Height="40" Padding="0" CornerRadius="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{StaticResource AccentBlueBrush}" Foreground="{StaticResource AccentBlueTextBrush}" BorderThickness="0" Click="OnSendChatClick">
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon Width="24" Height="24" Data="M13,20H11V8L5.5,13.5L4.08,12.08L12,4.16L19.92,12.08L18.5,13.5L13,8V20Z" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="StopBtn" Grid.Column="3" MinWidth="40" Width="40" MinHeight="40" Height="40" Padding="0" CornerRadius="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{StaticResource HoverBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" Click="OnStopChatClick" Visibility="Collapsed">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <PathIcon Width="24" Height="24" Data="M6,6H18V18H6Z" />
                            </Viewbox>
                        </Button>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right: Studio (Home grid OR embedded Artifact viewer) -->
        <Border x:Name="StudioPaneBorder" Grid.Row="1" Grid.Column="2" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
            <Grid>
                <Grid x:Name="StudioHomeView" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Studio" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,0" />
                    <Grid Grid.Row="1" ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource StudioTileStyle}" Tag="audio" Click="OnStudioTileClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <PathIcon Width="24" Height="24" Foreground="#A8C7FA" Data="M12,14C13.66,14 15,12.66 15,11V5C15,3.34 13.66,2 12,2C10.34,2 9,3.34 9,5V11C9,12.66 10.34,14 12,14M17,11C17,13.76 14.76,16 12,16C9.24,16 7,13.76 7,11H5C5,14.53 7.61,17.43 11,17.92V21H13V17.92C16.39,17.43 19,14.53 19,11H17Z" />
                                </Viewbox>
                                <TextBlock x:Name="TileAudioText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource StudioTileStyle}" Tag="slides" Click="OnStudioTileClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <PathIcon Width="24" Height="24" Foreground="#FDD663" Data="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.11 3.89,21 5,21H19C20.11,21 21,20.11 21,19V5C21,3.89 20.11,3 19,3M19,19H5V5H19V19M7,10H9V17H7V10M11,7H13V17H11V7M15,13H17V17H15V13Z" />
                                </Viewbox>
                                <TextBlock x:Name="TileSlidesText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource StudioTileStyle}" Tag="mindmap" Click="OnStudioTileClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <PathIcon Width="24" Height="24" Foreground="#C58AF9" Data="M12,2A3,3 0 0,1 15,5C15,6.28 14.19,7.38 13.06,7.81L14.5,10.5H16A3,3 0 0,1 19,13.5A3,3 0 0,1 16,16.5C14.68,16.5 13.56,15.66 13.16,14.5H10.84C10.44,15.66 9.32,16.5 8,16.5A3,3 0 0,1 5,13.5A3,3 0 0,1 8,10.5H9.5L10.94,7.81C9.81,7.38 9,6.28 9,5A3,3 0 0,1 12,2Z" />
                                </Viewbox>
                                <TextBlock x:Name="TileMindmapText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource StudioTileStyle}" Tag="report" Click="OnStudioTileClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <PathIcon Width="24" Height="24" Foreground="#81C995" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M8,12H16V14H8V12M8,16H13V18H8V16Z" />
                                </Viewbox>
                                <TextBlock x:Name="TileReportText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource StudioTileStyle}" Tag="flashcards" Click="OnStudioTileClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <PathIcon Width="24" Height="24" Foreground="#F6AEA9" Data="M4,6H2V20A2,2 0 0,0 4,22H18V20H4V6M20,2H8A2,2 0 0,0 6,4V16A2,2 0 0,0 8,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M20,16H8V4H20V16Z" />
                                </Viewbox>
                                <TextBlock x:Name="TileFlashcardsText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource StudioTileStyle}" Tag="quiz" Click="OnStudioTileClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <PathIcon Width="24" Height="24" Foreground="#78D9EC" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z" />
                                </Viewbox>
                                <TextBlock x:Name="TileQuizText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource StudioTileStyle}" Tag="infographic" Click="OnStudioTileClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <PathIcon Width="24" Height="24" Foreground="#FCAD70" Data="M3,3V21H21V19H5V3H3M9,17H7V10H9V17M13,17H11V7H13V17M17,17H15V13H17V17Z" />
                                </Viewbox>
                                <TextBlock x:Name="TileInfographicText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource StudioTileStyle}" Tag="lecture" Click="OnStudioTileClick">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <PathIcon Width="24" Height="24" Foreground="#F28B82" Data="M20,17A2,2 0 0,0 22,15V4A2,2 0 0,0 20,2H9.46C9.81,2.61 10,3.3 10,4H20V15H11V17M15,7V9H9V22H7V16H5V22H3V14H1.5V9A2,2 0 0,1 3.5,7H15M8,4A2,2 0 0,1 6,6A2,2 0 0,1 4,4A2,2 0 0,1 6,2A2,2 0 0,1 8,4Z" />
                                </Viewbox>
                                <TextBlock x:Name="TileLectureText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView x:Name="ArtifactsList" Grid.Row="2" SelectionMode="None" ItemContainerStyle="{StaticResource StretchListViewItemStyle}" />
                </Grid>

                <ContentControl x:Name="StudioDetailHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <InfoBar x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="3" IsOpen="False" IsClosable="True"
                 Severity="Informational" Title="" Message="" />
    </Grid>
</Window>
