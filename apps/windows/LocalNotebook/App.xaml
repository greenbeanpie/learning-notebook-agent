<Application
    x:Class="LocalNotebook.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Segoe UI</FontFamily>
            <SolidColorBrush x:Key="CanvasBgBrush" Color="#131314" />
            <SolidColorBrush x:Key="PanelBgBrush" Color="#1E1F20" />
            <SolidColorBrush x:Key="ElevatedBgBrush" Color="#282A2C" />
            <SolidColorBrush x:Key="HoverBgBrush" Color="#333537" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="StrongBorderBrush" Color="#3C4043" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E3E3E3" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C4C7C5" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8E918F" />
            <SolidColorBrush x:Key="AccentBlueBrush" Color="#A8C7FA" />
            <SolidColorBrush x:Key="AccentBlueTextBrush" Color="#131314" />

            <Style x:Key="PillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ElevatedBgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="PillDropDownButtonStyle" TargetType="DropDownButton">
                <Setter Property="Background" Value="{StaticResource ElevatedBgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="StudioTileStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ElevatedBgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10,10" />
                <Setter Property="MinHeight" Value="54" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>

            <Style x:Key="PrimaryPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBlueTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="Padding" Value="18,8" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Notebook switcher rows: touch-sized (just under the 38 px "new notebook" button). -->
            <Style x:Key="NotebookPickerItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
