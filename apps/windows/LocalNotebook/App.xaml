<Application
    x:Class="LocalNotebook.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="CanvasBgBrush" Color="#131314" />
            <SolidColorBrush x:Key="PanelBgBrush" Color="#1E1F20" />
            <SolidColorBrush x:Key="ElevatedBgBrush" Color="#282A2C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
