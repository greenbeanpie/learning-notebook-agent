{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AudioScriptPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "speakers", "turns"],
  "properties": {
    "title": { "type": "string" },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speaker", "text", "citations"],
        "properties": {
          "speaker": { "type": "string" },
          "text": { "type": "string" },
          "citations": { "type": "array", "items": { "type": "integer" } }
        }
      }
    }
  }
}
