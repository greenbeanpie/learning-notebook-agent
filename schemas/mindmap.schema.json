{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MindmapPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "nodes"],
  "properties": {
    "title": { "type": "string" },
    "kind": { "type": "string", "enum": ["mindmap", "knowledge_graph"] },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parent_id", "label", "citations"],
        "properties": {
          "id": { "type": "string" },
          "parent_id": { "type": ["string", "null"] },
          "label": { "type": "string" },
          "importance": { "type": "string", "enum": ["core", "key", "detail"] },
          "summary": { "type": "string" },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "facets": { "type": "array", "items": { "type": "string" } },
          "atomic": { "type": "boolean" },
          "citations": { "type": "array", "items": { "type": "integer" } }
        }
      }
    }
  }
}
