{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InfographicPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "subtitle", "orientation", "style", "blocks"],
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "orientation": { "type": "string", "enum": ["landscape", "portrait", "square"] },
    "style": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "metric", "summary", "citations"],
        "properties": {
          "heading": { "type": "string" },
          "metric": { "type": "string" },
          "summary": { "type": "string" },
          "citations": { "type": "array", "items": { "type": "integer" } }
        }
      }
    }
  }
}
